@echo off
chcp 65001 >nul
title Сборка автономного EXE файла
cls

echo ==================================================
echo    СБОРКА ПОЛНОСТЬЮ АВТОНОМНОГО EXE ФАЙЛА
echo ==================================================
echo.

echo Проверка виртуального окружения...
if exist ".venv\Scripts\activate.bat" (
    echo Активация виртуального окружения...
    call .venv\Scripts\activate.bat
    echo ✅ Виртуальное окружение активировано
) else (
    echo ⚠️  Виртуальное окружение не найдено
    echo Будет использован системный Python
)

echo.
echo Установка PyInstaller (если необходимо)...
pip install pyinstaller

echo.
echo ==================================================
echo Начинается сборка автономного EXE файла...
echo Это может занять несколько минут
echo ==================================================
echo.

python build_exe.py

echo.
echo ==================================================
if exist "dist\[Search]Driver.exe" (
    echo ✅ СБОРКА ЗАВЕРШЕНА УСПЕШНО!
    echo.
    echo Файл: dist\[Search]Driver.exe
    echo Размер: %~z0 байт
    echo.
    echo 🎉 Файл готов к использованию на любом Windows компьютере!
    echo 💾 Можно скопировать на флешку и запускать без Python
) else (
    echo ❌ СБОРКА НЕ УДАЛАСЬ
    echo Проверьте сообщения об ошибках выше
)
echo ==================================================
pause